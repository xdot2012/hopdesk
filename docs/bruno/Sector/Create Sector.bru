meta {
  name: Create Sector
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/sector/
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Suporte N1",
    "color": "#2563eb"
  }
}

script:post-response {
  let data = res.body;
  if (data && data.id) {
    bru.setEnvVar("sector_id", data.id);
  }
}
